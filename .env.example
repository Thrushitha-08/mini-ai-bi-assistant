# Copy this file to `.env` and edit it. NEVER commit `.env` (it is in .gitignore).
# The app works with NO LLM at all: leave GEMINI_API_KEY empty to use the keyword fallback.

# --- Google Gemini (optional) --------------------------------------------------
# Get a key at https://aistudio.google.com/apikey , then paste it after the = sign.
GEMINI_API_KEY=

# Model name (optional). If Google retires the default, pick a current one from the Gemini docs.
# GEMINI_MODEL=gemini-2.5-flash

# Seconds to wait for Gemini before falling back to keywords (optional)
# LLM_TIMEOUT=15

# --- Paths & display (all optional) ------------------------------------------
# CSV_PATH=data/ai_bi_assistant_sales_data - GET.csv
# DB_PATH=data/sales.db
# CURRENCY_SYMBOL=₹

# --- Streamlit -> API address ------------------------------------------------
# API_URL=http://localhost:8000
